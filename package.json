{
  "name": "pyra-launcher",
  "version": "1.0.0",
  "description": "Pyra - Modern Windows Desktop Game Launcher",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "keywords": [
    "game-launcher",
    "electron",
    "react",
    "typescript",
    "vite",
    "gaming"
  ],
  "author": "Pyra Team",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
